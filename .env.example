DATABASE_URL=
DIRECT_URL=

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

DATAGSM_CLIENT_ID=
DATAGSM_CLIENT_SECRET=

# E2E 테스트·로컬 개발용 로그인 우회. 값은 mock 하나뿐이다.
# 운영(GSMSV)에는 넣지 않는다. 넣어도 localhost가 아닌 주소에서는 열리지 않는다(lib/auth.ts).
AUTH_MODE=

# 오류 수를 세는 주소(/api/errors/summary)의 비밀 값. GitHub Actions secret과 같은 값.
MONITOR_TOKEN=

# 모바일 앱 푸시 알림(FCM). Firebase 서비스 계정 키 JSON을 통째로 또는 base64로. 없으면 알림을 보내지 않는다.
# 운영 VM에는 deploy/set-secrets.sh로만 넣는다.
FIREBASE_SERVICE_ACCOUNT=
