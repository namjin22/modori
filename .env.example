DATABASE_URL=
DIRECT_URL=

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

DATAGSM_CLIENT_ID=
DATAGSM_CLIENT_SECRET=

# Apple 로그인(iOS 앱 심사에 필요). AUTH_APPLE_ID는 Services ID, 키는 .p8 내용을 한 줄로(줄바꿈은 \n으로 적는다).
AUTH_APPLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# iOS 푸시(APNs). Apple 로그인 키에서 "Apple Push Notifications service"도 켜 두면 위 값을 그대로 쓴다. 다른 키를 쓰려면 아래를 채운다.
APNS_KEY_ID=
APNS_PRIVATE_KEY=

# E2E 테스트·로컬 개발용 로그인 우회. 값은 mock 하나뿐이다.
# 운영(GSMSV)에는 넣지 않는다. 넣어도 localhost가 아닌 주소에서는 열리지 않는다(lib/auth.ts).
AUTH_MODE=

# 오류 수를 세는 주소(/api/errors/summary)의 비밀 값. GitHub Actions secret과 같은 값.
MONITOR_TOKEN=

# 모바일 앱 푸시 알림(FCM). Firebase 서비스 계정 키 JSON을 통째로 또는 base64로. 없으면 알림을 보내지 않는다.
# 운영 VM에는 deploy/set-secrets.sh로만 넣는다.
FIREBASE_SERVICE_ACCOUNT=

# 웹 푸시(컴퓨터 브라우저 알림) 서버 열쇠. 운영 VM에는 deploy/set-vapid.sh로만 만든다. 없으면 브라우저는 창이 열려 있을 때만 알린다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
