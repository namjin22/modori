generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // 풀링 연결 — 앱에서 사용
  directUrl = env("DIRECT_URL") // 직접 연결 — 마이그레이션에서 사용
}

// ========================================
// 인증 — Auth.js 표준 모델
// ========================================

model User {
  // Auth.js가 요구하는 필드
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // 모도리 고유 필드
  // 최초 로그인 후 온보딩에서 입력받는다. 친구를 찾는 이름이라 겹치면 안 된다.
  // 대소문자까지 구분하는 제약이라, 앱에서 대소문자 무시 비교를 한 번 더 한다.
  nickname          String?   @unique
  // 올린 사진을 128×128로 줄인 data URL. 없으면 화면에서 도리 얼굴을 쓴다.
  profileImage      String?
  // 프로필 사진으로 고른 캐릭터(lib/characters.ts의 id). 없으면 도리. 사진(profileImage)이 있으면 사진이 먼저다.
  avatarCharacter   String?
  bio               String?
  lastSeenAt        DateTime  @default(now()) // 안 읽은 반응 뱃지 기준점
  privacyAgreedAt   DateTime? // 가입할 때 개인정보 수집·이용에 동의한 시각
  // 어느 링크로 와서 가입했는지(초대 링크의 ?from=discord 같은 표시, lib/signup-source.ts). 합계로만 본다. 가입 때 한 번 적는다.
  signupSource      String?
  // 켜면 친구 찾기의 "추천 친구"에 나오지 않는다(마이페이지에서 고른다). 닉네임 검색에는 그대로 나온다.
  hideFromRecommend Boolean   @default(false)
  // 이 사람의 "오늘"을 정하는 시간대(IANA 이름, lib/timezones.ts의 목록 중 하나). 날짜 값(@db.Date)은 시각 없는 달력의 날이라 시간대와 무관하다.
  timezone          String    @default("Asia/Seoul")
  createdAt         DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  desktopLogins DesktopLogin[]
  categories    Category[]
  todos         Todo[]
  routines      Routine[]
  events        Event[]
  following     Follow[]       @relation("follower")
  followers     Follow[]       @relation("following")
  reactions     Reaction[]
  activeDays    ActiveDay[]
  pushTokens    PushToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String // "google" | "datagsm"
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ========================================
// 소셜
// ========================================

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model Reaction {
  id         String   @id @default(cuid())
  userId     String // 반응을 누른 사람
  todoId     String
  // 반응을 받은 사람(할 일 주인). todo.userId와 같은 값을 따로 들고 있다.
  // "내가 받은 반응"을 찾을 때 할 일 테이블을 거치면 할 일이 쌓일수록 느려진다.
  // 할 일의 주인은 바뀌지 않으므로 어긋날 일이 없다.
  todoUserId String
  emoji      String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@unique([userId, todoId, emoji]) // 같은 이모지 중복 방지
  @@index([todoId])
  @@index([todoUserId, createdAt]) // 받은 반응 목록과 안 읽은 수
}

// ========================================
// 할 일
// ========================================

model Category {
  id         String    @id @default(cuid())
  userId     String
  name       String
  color      String // hex — 캘린더를 채우는 색
  order      Int
  isPublic   Boolean   @default(true) // false면 피드에 노출되지 않음
  archivedAt DateTime? // 삭제 대신 보관 (과거 기록 보존)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  todos    Todo[]
  routines Routine[]

  @@index([userId, order])
}

model Todo {
  id         String    @id @default(cuid())
  userId     String
  categoryId String?
  content    String
  date       DateTime  @db.Date // 시각 없음. Asia/Seoul 기준 날짜만
  done       Boolean   @default(false)
  doneAt     DateTime?
  order      Int       @default(0)
  routineId  String? // 루틴이 생성한 인스턴스면 채워진다
  color      String? // 비어 있으면 카테고리 색을 쓴다
  memo       String? // 본인만 본다. 친구 화면·피드에는 보내지 않는다
  createdAt  DateTime  @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  routine   Routine?   @relation(fields: [routineId], references: [id], onDelete: SetNull)
  reactions Reaction[]

  // 루틴 중복 생성을 DB가 막는다.
  // routineId가 NULL인 일반 할 일은 Postgres가 NULL을 서로 다르게 취급하므로
  // 같은 날짜에 여러 개 만들어도 걸리지 않는다.
  @@unique([routineId, date])
  @@index([userId, date])
  @@index([userId, done, doneAt]) // 피드 조회용
}

enum RoutineFreq {
  DAILY
  WEEKLY
  MONTHLY
}

model Routine {
  id         String      @id @default(cuid())
  userId     String
  categoryId String?
  content    String
  freq       RoutineFreq
  byWeekday  Int[]       @default([]) // WEEKLY일 때. 0=일 … 6=토
  byMonthday Int[]       @default([]) // MONTHLY일 때. 1 … 31
  startDate  DateTime    @db.Date
  endDate    DateTime?   @db.Date
  pausedAt   DateTime?
  order      Int         @default(0)
  createdAt  DateTime    @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  todos    Todo[]
  skips    RoutineSkip[]

  @@index([userId])
}

// 루틴이 만든 할 일을 사용자가 지운 날.
// 할 일은 그 날짜를 열 때 없으면 만들어지므로, 지운 사실을 따로 남기지 않으면
// 지우자마자 다시 생긴다. 루틴을 지우면 이 기록도 같이 사라진다.
model RoutineSkip {
  routineId String
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@id([routineId, date])
}

// 일정. 할 일과 달리 체크하지 않고, 달력에 이름으로 보인다.
// 시험 기간처럼 여러 날에 걸칠 수 있어서 시작일과 종료일을 둔다. 하루짜리는 둘이 같다.
model Event {
  id        String   @id @default(cuid())
  userId    String
  title     String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  // 시각은 날짜와 따로, 자정부터 몇 분인지로 둔다(0~1439). 비어 있으면 하루 종일.
  // 시작 시간은 시작일, 끝 시간은 종료일의 시각이다. 날짜를 @db.Date로 두는 규칙을 그대로 지킨다.
  startTime Int?
  endTime   Int?
  color     String
  memo      String? // 본인만 본다
  // D-day를 보일지. 끄면 일정 카드의 D-day와 "다가오는 일정" 목록에서 빠진다(일정이 많을 때 중요한 것만 남긴다).
  dday      Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
}

// 서버·브라우저에서 난 오류. instrumentation.ts와 /api/errors가 쌓고 /admin/errors에서 본다.
// 30일 지난 것은 지운다(lib/errors.ts). 사용자 입력을 그대로 담지 않도록 내용은 짧게 자른다.
model ErrorEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  source    String // server | client
  message   String
  digest    String?
  path      String?

  @@index([createdAt])
}

// 데스크톱 앱 로그인에 한 번 쓰는 코드. 브라우저에서 로그인한 사람에게 발급하고(app/desktop/login),
// 앱이 처음 만든 비밀값(verifier)과 함께 바꿔 세션을 받는다(app/api/desktop/exchange). 쓰면 지우고 2분 뒤에는 못 쓴다.
// 코드는 해시로만 둔다. challenge는 verifier의 SHA-256(base64url)이다(PKCE, RFC 7636).
model DesktopLogin {
  id        String   @id @default(cuid())
  codeHash  String   @unique
  challenge String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// 모바일 앱이 푸시 알림(받은 반응, 새 팔로워)을 받으려고 알려 준 기기 알림 번호(FCM 토큰).
// 같은 기기가 다른 계정으로 로그인하면 그 계정으로 옮겨 온다. 로그아웃하거나 계정을 지우면 지우고,
// 알림을 보냈는데 Google이 더는 없는 번호라고 하면(앱 삭제 등) 그때도 지운다(lib/push.ts).
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String // "android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ========================================
// 지표 (docs/metrics.md)
// ========================================

// 그날 모도리를 쓴 사람. 가입을 마친 사람이 로그인한 채 화면을 열거나 무언가를 하면 하루에 한 행(lib/metrics.ts).
// 활성 사용자와 재방문율을 세는 데만 쓴다. 시각은 두지 않고, 90일 지난 행은 지운다. 계정을 지우면 같이 지워진다.
model ActiveDay {
  userId String
  date   DateTime @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@index([date])
}

// 하루에 한 번 찍는 합계. 사람을 알 수 없는 숫자만 둔다. 계정·할 일이 나중에 지워지거나 ActiveDay가 90일 뒤
// 지워져도 그날의 숫자는 남는다. 값은 그날 끝(한국 자정) 기준이다.
model DailyStat {
  date               DateTime @id @db.Date
  accounts           Int // 로그인한 적 있는 계정(닉네임 전 포함)
  users              Int // 가입을 마친 계정(닉네임 있음)
  withTodo           Int // 할 일을 하나라도 적은 사람
  withFollow         Int // 한 명 이상 팔로우한 사람
  withReaction       Int // 반응을 한 번이라도 보낸 사람
  dau                Int // 그날 쓴 사람
  wau                Int // 그날까지 7일 동안 쓴 사람
  todosCreated       Int // 그날 직접 적은 할 일(루틴이 만든 것 빼고)
  follows            Int // 팔로우 연결 수
  reactionsCreated   Int // 그날 보낸 반응
  reactionsCharacter Int      @default(0) // 그 가운데 캐릭터 표정 반응(나머지는 이모지)
  cohortSize         Int // 7일 전에 가입한 사람
  cohortReturned     Int // 그 가운데 가입 다음 날부터 7일 안에 다시 쓴 사람
  // 그날까지 가입을 마친 사람의 가입 경로별 누적({"discord": 12, "kakao": 3}). 경로를 모르는 사람은 "direct". 계정이 지워져도 남는 합계다.
  sources            Json?
  createdAt          DateTime @default(now())
}
